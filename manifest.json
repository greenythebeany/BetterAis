{
  "manifest_version": 3,
  "name": "BetterAis",
  "version": "3.0",
  "description": "Modern redesign of STU AIS (is.stuba.sk): light and dark themes, unified icons, cleaner tables, and a custom accent color.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://is.stuba.sk/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://is.stuba.sk/*"
      ],
      "js": [
        "content.js",
        "icons.js"
      ],
      "css": [
        "style.css",
        "themes.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://is.stuba.sk/auth/*",
        "*://is.stuba.sk/system/login.pl*"
      ],
      "css": [
        "login.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
